<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuración de pruebas para el proyecto Clínica Odontológica.

    Se usa MySQL (la misma base que .env) porque el esquema depende de
    características de MySQL (columnas generadas, índices compuestos y
    claves foráneas compuestas) que SQLite no soporta.

    Todas las pruebas usan DatabaseTransactions: cada test se revierte.
    Ejecutar con:  php artisan test usando este archivo de configuracion.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="clinica_odontologica"/>
        <env name="LOG_CHANNEL" value="stderr"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="VIEW_COMPILED_PATH" value="C:/Users/ronal/OneDrive/Documents/deepseek-harness/default-workspace/tmp-php/views"/>
    </php>
</phpunit>
